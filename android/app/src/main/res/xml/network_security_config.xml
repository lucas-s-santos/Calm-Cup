<?xml version="1.0" encoding="utf-8"?>
<!-- O app só fala com raw.githubusercontent.com (HTTPS) — nega cleartext
     explicitamente em vez de depender só do default do Android. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
